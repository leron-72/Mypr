# PostgreSQL
POSTGRES_DB=nomenclature
POSTGRES_USER=nomen
POSTGRES_PASSWORD=nomen_secret

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=nomenclature-files
MINIO_SECURE=false

# JWT Auth
SECRET_KEY=supersecretkey_change_in_production_use_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
BACKEND_CORS_ORIGINS=*

# Database URL (constructed from above)
DATABASE_URL=postgresql+asyncpg://nomen:nomen_secret@localhost:5432/nomenclature

# Frontend
VITE_API_URL=http://localhost:8000
